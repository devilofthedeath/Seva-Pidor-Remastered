; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Seva Pidor: Origins"
run/main_scene="res://scenes/levels/main_menu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
GameEvents="*res://scripts/autoload/GameEvents.gd"
RunState="*res://scripts/autoload/RunState.gd"
SceneRouter="*res://scripts/autoload/SceneRouter.gd"
SaveService="*res://scripts/autoload/SaveService.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
DialogueService="*res://scripts/autoload/DialogueService.gd"
GameState="*res://scripts/autoload/GameState.gd"
Localization="*res://scripts/autoload/Localization.gd"
AutoSave="*res://scripts/autoload/AutoSave.gd"
DisplayManager="*res://scripts/autoload/DisplayManager.gd"
CameraShake="*res://scripts/autoload/CameraShake.gd"
HitStop="*res://scripts/autoload/HitStop.gd"
FX="*res://scripts/autoload/FX.gd"
SettingsService="*res://scripts/autoload/SettingsService.gd"
PauseManager="*res://scripts/autoload/PauseManager.gd"

[dialogue_manager]

runtime/balloon_path="res://scenes/ui/dima_small_balloon.tscn"

[display]

window/size/viewport_width=720
window/size/viewport_height=480
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[gui]

theme/custom="res://assets/fonts/modula_theme.tres"

